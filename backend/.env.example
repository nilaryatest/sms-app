# ── Database ──────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql://postgres:password@localhost/sms_db
# Neon production (example):
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── JWT Authentication ────────────────────────────────
SECRET_KEY=your_super_secret_jwt_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS (Frontend URL) ──────────────────────────────
# Set this to your deployed frontend URL on Render/Vercel
# FRONTEND_URL=https://sms-frontend.vercel.app
